---
interface Props { id: string; placement?: 'hero' | 'section'; label: string }
const { id, placement = 'section', label } = Astro.props;
---
<div id={id} class:list={['particles-layer', placement === 'hero' && 'hero-particles']}
  data-particles-host aria-hidden="true" data-particles-state="static"></div>
<button class:list={['particle-motion-control', placement === 'hero' && 'hero-motion-control']}
  data-particles-toggle data-placement={placement} type="button" aria-pressed="true"
  aria-controls={id} aria-label={`Pausar animación de ${label}`} data-particles-label={label} hidden>
  Pausar animación
</button>
<script src="../scripts/particle-fields.ts"></script>
<style>
  .particles-layer { position: absolute; inset: 0; z-index: -1; pointer-events: none; visibility: hidden; }
  .particles-layer[data-particles-state="active"],
  .particles-layer[data-particles-state="paused"] { visibility: visible; }
  .particles-layer :global(canvas) { display: block; width: 100%; height: 100%; }
  :global(.color-field[data-particles-active="true"] > .network) { visibility: hidden; }
  .particle-motion-control {
    position: absolute; top: 90px; right: max(32px, calc((100% - 1140px) / 2));
    z-index: 4; min-height: 36px; padding: 7px 14px; border-radius: 30px;
    background: #fff; color: #212529; font-size: 12px; line-height: 1.5;
  }
  .particle-motion-control[data-placement="hero"] { top: var(--hero-control-top, 96px); bottom: var(--hero-control-bottom, auto); }
  .particle-motion-control:hover { background: #f8edf4; }
  /* Oculto a la vista por decisión del dueño (21-11-2026); aparece solo al llegar con el teclado,
     para que siga siendo posible detener la animación (WCAG 2.2.2). */
  .particle-motion-control:not(:focus-visible) { clip-path: inset(50%); width: 1px; min-height: 0; height: 1px; padding: 0; overflow: hidden; white-space: nowrap; }
  @media (min-width: 651px) and (max-width: 1050px) {
    .particle-motion-control[data-placement="section"] { top: 52px; }
  }
  @media (max-width: 650px) {
    .particle-motion-control { top: 68px; right: 20px; min-height: 32px; padding-block: 5px; }
    .particle-motion-control[data-placement="hero"] { top: var(--hero-control-top, 78px); }
  }
</style>
