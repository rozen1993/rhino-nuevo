---
// Página interior con el diseño v4 aprobado el 22-11-2026 (visuales-claude/paginas-completasv4).
// El orden y el tipo de cada sección salen de src/data/maquetas-v4.json; el texto, de la ficha (getPageContent).
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon from '../Icon.astro';
import PageLink from '../PageLink.astro';
import Atmosphere from '../Atmosphere.astro';
import ParticleField from '../ParticleField.astro';
import LiveIcon from './LiveIcon.astro';
import Heading from './Heading.astro';
import SeeAlso from './SeeAlso.astro';
import cases from '../../data/cases.json';
import { getPage, getShortName } from '../../lib/seo.mjs';
import { iconFor, ICONS } from '../../lib/iconos.mjs';
import '../../styles/escena.css';

const { page, content, layout } = Astro.props;
const IC = ICONS as Record<string, string>;
const { intro, cta, sections, closing, extra } = content;
const waText = extra.whatsapp ?? `Hola Rhino, quiero consultar sobre ${page.h1.toLowerCase()}.`;
const wa = 'https://wa.me/51965683542?text=' + encodeURIComponent(waText);
const mail = 'mailto:info@rhinoaudiovisuales.com?subject=' + encodeURIComponent(`Consulta: ${page.h1}`);
const [lead, ...restParts] = intro.split('. ');
const rest = restParts.join('. ');
const collageSize = layout.collage?.largeSize ?? 1024;
// Diseño «escena» (aprobado el 25-11-2026 en Cobertura): con layout.hero, cabecera a pantalla completa con escena viva
// en lugar de la introducción con collage; la frase de la intro (con la keyword) baja a la primera sección.
const hero = layout.hero;
const introFirst = (k: number) => hero && k === 0 ? [intro] : [];
const media = (name: string, size: number) => `/media/${name}-${size}.webp`;
const caseImage = (id: string) => '/media/' + id + (['bloom', 'adidas'].includes(id) ? '-display.webp' : '-1280.webp');
const yt = (video: string) => 'https://www.youtube.com/watch?v=' + video;
const shortName = (p: any) => getShortName(p);

// Fondos alternos blanco/lila en recto (las ondas quedan solo en cabecera, banda de relacionados y pie).
// La banda de imagen (band) lleva su propio fondo y no cuenta en la alternancia.
let band = 0, splits = 0;
const blocks = layout.sections.map((spec: any) => {
  const group = (spec.indexes ?? [spec.index]).map((i: number) => sections[i]);
  if (group.some((s: any) => !s)) throw new Error(`${page.id}: la maqueta v4 pide una sección que no existe (${spec.indexes ?? spec.index})`);
  // Con cabecera viva («hero») la alternancia empieza en blanco, para que las migas continúen en la primera sección.
  const bg = spec.type === 'band' ? '' : ((band++ + (layout.hero ? 1 : 0)) % 2 === 0 ? 'bg-l' : 'bg-w');
  const rev = spec.type === 'split' && splits++ % 2 === 1;
  return { ...spec, index: spec.index ?? spec.indexes[0], section: group[0], group, bg, rev };
});
const used = new Set(blocks.flatMap((b: any) => b.indexes ?? [b.index]));
const missing = sections.map((_: any, i: number) => i).filter((i: number) => !used.has(i));
if (missing.length) throw new Error(`${page.id}: secciones sin bloque en la maqueta v4: ${missing.join(', ')}`);
const lastBg = blocks.at(-1)?.bg || 'bg-w';
const related = layout.related === false ? [] : page.relatedIds.map((id: string) => getPage(id))
  .filter((p: any) => p.type === 'html' && p.id !== 'P33' && p.id !== page.id && !p.path?.startsWith('/portafolio/'));
const belt = (layout.belt ?? []).map((id: string) => getPage(id));
const srcset = (name: string, sizes: number[] = [640, 1280]) => sizes.map(w => `${media(name, w)} ${w}w`).join(', ');
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
// T2 · frase destacada: la primera frase en grande, con la parte «accent» que se ilumina; el resto debajo.
function quoteParts(s: any, accent?: string) {
  const [first, ...more] = s.paragraphs[0].split('. ');
  const big = first.endsWith('.') || first.endsWith('?') ? first : first + '.';
  if (accent && !big.includes(accent)) throw new Error(`${page.id}: la frase destacada no contiene «${accent}»`);
  const [before, after] = accent ? big.split(accent) : [big, ''];
  return { before, accent, after, rest: [more.join('. '), ...s.paragraphs.slice(1)].filter(Boolean) };
}
// T9 · la última frase pasa a la nota «A tener en cuenta».
function asideParts(s: any) {
  const text = s.paragraphs.join(' ');
  const cut = text.lastIndexOf('. ', text.length - 2);
  if (cut < 0) throw new Error(`${page.id}: «${s.title}» necesita al menos dos frases para la nota`);
  return { body: text.slice(0, cut + 1), note: text.slice(cut + 2) };
}
// T7 · «Término: descripción» con el término en negrita.
const listItem = (i: string) => { const [t, ...d] = i.split(': '); return d.length && t.length < 40 ? { t, d: d.join(': ') } : { t: '', d: i }; };
// T5 de P02 · cada «Término: descripción» va en la tarjeta de su enlace (por la primera palabra).
const firstWord = (t: string) => t.toLowerCase().split(/\s+/)[0];
function descsFromItems(s: any) {
  const out: Record<string, string> = {};
  for (const it of s.items) { const [term, d] = it.split(': '); const l = s.links.find(([, label]: string[]) => firstWord(label) === firstWord(term)); if (l) out[l[0]] = cap(d); }
  return out;
}
// Datos fijos de los bloques «escena» del resto de páginas (26-11-2026): pistas de la línea de tiempo (izquierda %, ancho %, color),
// días del calendario con pieza y su icono.
const TRACKS = [['V2', [[8, 18, 'b'], [44, 20, 'c'], [76, 14, 'b']]], ['V1', [[0, 26, 'a'], [27, 22, 'c'], [50, 30, 'a'], [81, 19, 'c']]], ['A1', [[0, 62, 'w'], [63, 37, 'w']]]];
const WEEK = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
const CHIPS: Record<number, string> = { 1: 'camera', 3: 'video', 5: 'text', 8: 'camera', 10: 'text', 12: 'video', 15: 'camera', 17: 'text', 19: 'video', 22: 'camera', 24: 'text', 26: 'video', 29: 'camera', 31: 'text' };
const CHIP_ICON: Record<string, string> = { camera: IC.camera, video: IC.video, text: '<path d="M4 7h16M4 12h12M4 17h8"/>' };
const STEPS = [
  ['message', 'Cuéntanos tu necesidad.', 'Puede ser una idea, una fecha o un problema de comunicación.'],
  ['calendar', 'Comparte el contexto.', 'Para un evento: lugar y fecha, si los conoces. Para una pieza: mensaje y uso previsto.'],
  ['send', 'Hablemos de tu proyecto.', 'Elige WhatsApp o correo para iniciar la conversación.'],
];
---
<main id="main" class="v4-main" data-v4>
  <svg width="0" height="0" class="v4-defs" aria-hidden="true"><defs>
    <linearGradient id="v4-brand" gradientUnits="userSpaceOnUse" x1="2" y1="2" x2="22" y2="22"><stop stop-color="#fe802d"/><stop offset=".5" stop-color="#fe0840"/><stop offset="1" stop-color="#ac0bd9"/></linearGradient>
    <linearGradient id="xj-sol" gradientUnits="userSpaceOnUse" x1="4" y1="0" x2="60" y2="0"><stop stop-color="#fe802d"/><stop offset=".5" stop-color="#fe0840"/><stop offset="1" stop-color="#ac0bd9"/></linearGradient>
  </defs></svg>

  <!-- Cabecera: con «hero», escena viva a pantalla completa (diseño «escena», 25-11-2026); si no, introducción como «Producción audiovisual» de la home,
       con el collage elegido el 23-11-2026 (visuales-claude/2026-11-22-fotos-collage, N2): grande cuadrada con el momento del evento,
       pequeña vertical 2:3 con la captura. Fotos ilustrativas creadas con IA; los anchos de «sizes» son los huecos medidos con object-fit: cover. -->
  {hero ? (<>
  <section class="xh" aria-labelledby="page-title">
    <div class="xh-scene" data-escena={JSON.stringify(hero.scene)}>
      <img class="xh-still" src={media(hero.image, hero.sizes[1])} srcset={srcset(hero.image, hero.sizes)} sizes="(max-width: 760px) 260vw, 100vw"
        width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" style={`object-position: ${hero.scene.pos[0] * 100}% ${hero.scene.pos[1] * 100}%; --pos-m: ${hero.scene.posMobile[0] * 100}% ${hero.scene.posMobile[1] * 100}%`} />
    </div>
    <div class="xh-shade" aria-hidden="true"></div>
    <button class="xh-pause" type="button" hidden aria-label="Pausar animación">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path class="pause-icon" d="M3 2h3.6v12H3zm6.4 0H13v12H9.4z"/><path class="play-icon" d="M4 2.5v11l9.5-5.5z"/></svg>
    </button>
    <div class="xh-copy">
      <h1 id="page-title">{page.h1}</h1>
      <p>{hero.lead}</p>
      <a class="action gradient-action" data-magnet href={wa} target="_blank" rel="noopener noreferrer"><span>{cta}</span><span class="action-arrow"><Icon /></span></a>
    </div>
    <svg class="xh-hem" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true">
      <defs><linearGradient id="xh-onda" x1="0" x2="1"><stop offset="0" stop-color="#fe802d"/><stop offset=".45" stop-color="#fe0840"/><stop offset="1" stop-color="#ac0bd9"/></linearGradient></defs>
      <path fill="#fff" d="M0 34C360 10 760 60 1440 18V64H0Z"/>
      <path fill="none" stroke="url(#xh-onda)" stroke-width="5" d="M0 34C360 10 760 60 1440 18"/>
    </svg>
  </section>
  <div class="wrap x-crumbs"><Breadcrumbs page={page} /></div>
  </>) : (
  <section class="v4-intro wrap" aria-labelledby="page-title">
    <div class="v4-intro-copy">
      <Breadcrumbs page={page} />
      <h1 id="page-title" class="v4-title">{page.h1}<span class="presentation-accent" aria-hidden="true"></span></h1>
      <p class="v4-lead">{lead}{rest ? '.' : ''}</p>
      {rest && <p>{rest}</p>}
      <div class="v4-acts">
        <a class="action gradient-action" data-magnet href={wa} target="_blank" rel="noopener noreferrer"><span>{cta}</span><span class="action-arrow"><Icon /></span></a>
        <a class="inline-action" href={mail}>Escribir por correo <Icon size={18} /></a>
      </div>
    </div>
    <figure class="v4-collage" data-parallax>
      <img class="v4-big" src={media(layout.collage.image, collageSize)} srcset={`${media(layout.collage.image, 640)} 640w, ${media(layout.collage.image, collageSize)} ${collageSize}w`}
        sizes="(max-width: 650px) 270px, (max-width: 880px) 66vw, 400px" width={layout.collage.width ?? 1024} height={layout.collage.height ?? 1024} alt={layout.collage.alt} fetchpriority="high" decoding="async" />
      <img class="v4-small" src={media(layout.collage.second, collageSize)} srcset={`${media(layout.collage.second, 640)} 640w, ${media(layout.collage.second, collageSize)} ${collageSize}w`}
        sizes="(max-width: 650px) 140px, (max-width: 880px) 37vw, 210px" width={layout.collage.secondWidth ?? 1024} height={layout.collage.secondHeight ?? 1536} alt="" decoding="async" />
    </figure>
  </section>
  )}

  <!-- 11 · Cinta de servicios (P02): se desplaza sola; se detiene con el cursor, el foco o el botón, y con «reducir movimiento» queda quieta. -->
  {belt.length > 0 && (
    <section class="v4-belt" aria-label="Servicios principales" data-belt>
      <button type="button" class="v4-belt-pause" aria-pressed="false" data-belt-pause>Pausar cinta</button>
      <div class="v4-belt-in">
        <ul class="v4-belt-track">
          {belt.map((p: any) => <li><PageLink pageId={p.id} label={shortName(p)}>{shortName(p)}</PageLink></li>)}
          {belt.map((p: any) => <li aria-hidden="true"><span>{shortName(p)}</span></li>)}
        </ul>
      </div>
    </section>)}

  {blocks.map((b: any, k: number) => {
    const s = b.section;
    const id = `sec-${b.index + 1}`;
    if (b.type === 'visor') return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap xv-split">
          <div class="v4-copy"><Heading text={s.title} />{[...introFirst(k), ...s.paragraphs].map((p: string) => <p>{p}</p>)}
            {s.items.length > 0 && <ul class="xv-list">{s.items.map((it: string) => { const x = listItem(it); return (
              <li><svg class="v4-tick" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="url(#v4-brand)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.check} /></svg><p>{x.t && <strong>{x.t}:</strong>} {x.d}</p></li>); })}</ul>}
            <SeeAlso links={s.links} /></div>
          <figure class:list={['xv', b.live && 'xv-live', b.mode === 'photo' && 'xv-shoot']} data-x-open>
            <span class="xv-in"><img src={media(b.image, b.sizes.at(-1))} srcset={srcset(b.image, b.sizes)} sizes="(max-width: 880px) 100vw, 540px" width={b.width} height={b.height} alt={b.alt} loading="lazy" decoding="async" /></span>
            <span class="xv-ui" aria-hidden="true"><span class="xv-c tl"></span><span class="xv-c tr"></span><span class="xv-c bl"></span><span class="xv-c br"></span>{b.live ? <span class="xv-onair"><i></i>EN VIVO</span> : b.mode === 'photo' ? <span class="xv-rec xv-photo">1/160 · F4 · ISO 200</span> : <span class="xv-rec"><i></i>REC</span>}{b.mode === 'photo' ? <span class="xv-tc">[<span data-shots>36</span>]</span> : <span class="xv-tc" data-tc>00:00:00:00</span>}<span class="xv-focus"></span></span>
            <span class="xv-hatch" aria-hidden="true"></span>
          </figure>
        </div>
      </section>);
    // Diseño «escena» en Catering (26-11-2026): los formatos como momentos de la jornada. Cada foto se «ilumina» al aparecer
    // y un pequeño arco marca la altura del sol (mañana, media mañana, mediodía).
    if (b.type === 'jornada') return (
      <section id={id} class:list={['v4-sec', b.bg]}>
        <div class="wrap">
          <div class="xf-head"><Heading text={s.title} />{[...introFirst(k), ...s.paragraphs].map((p: string) => <p>{p}</p>)}<SeeAlso links={s.links} /></div>
          <ul class="xj-list">
            {b.moments.map((m: any, j: number) => (
              <li class="xj-item" data-x-open style={`--sun:${m.sun}; --i:${j}`}>
                <div class="xj-photo"><img src={media(m.image, m.sizes.at(-1))} srcset={srcset(m.image, m.sizes)} sizes="(max-width: 880px) 100vw, 380px" alt={m.alt} loading="lazy" decoding="async" /></div>
                <div class="xj-copy">
                  <svg class="xj-dial" viewBox="0 0 64 36" width="64" height="36" aria-hidden="true">
                    <path class="xj-arc" d="M4 32 A28 28 0 0 1 60 32" />
                    <path class="xj-trail" d="M4 32 A28 28 0 0 1 60 32" pathLength="100" />
                    <line x1="0" y1="32.5" x2="64" y2="32.5" class="xj-horizon" />
                    <g class="xj-rot"><circle class="xj-sun" r="5" cx="4" cy="32" /></g>
                  </svg>
                  <p class="xj-time">{m.time}</p>
                  <h3>{m.label}</h3>
                </div>
              </li>))}
          </ul>
        </div>
      </section>);
    // Diseño «escena» en Organización de eventos (26-11-2026): las áreas del encargo como una escaleta de evento;
    // cada fila enciende su luz de aviso al aparecer y la línea del programa avanza hasta ella.
    if (b.type === 'escaleta') {
      const terms = s.items.map((it: string) => it.split(': '));
      return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap xe-grid">
          <div class="xe-head"><Heading text={s.title} />{[...introFirst(k), ...s.paragraphs].map((p: string) => <p>{p}</p>)}<SeeAlso links={s.links} /></div>
          <ol class="xe-sheet">
            {terms.map(([t, d]: string[], j: number) => (
              <li class="xe-row" data-x-open style={`--i:${j}`}>
                <span class="xe-cue" aria-hidden="true"></span>
                <svg class="xe-ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC[b.icons?.[j] ?? 'check']} /></svg>
                <div><h3>{t}</h3><p>{cap(d)}</p></div>
              </li>))}
          </ol>
        </div>
      </section>);
    }
    // Diseño «escena» en Video corporativo (26-11-2026): cada motivo en una claqueta que se cierra al aparecer.
    if (b.type === 'claquetas') return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap">
          <div class="xf-head"><Heading text={s.title} />{[...introFirst(k), ...s.paragraphs].map((p: string) => <p>{p}</p>)}<SeeAlso links={s.links} /></div>
          <ul class="xq-list">
            {s.items.map((it: string, j: number) => (
              <li class="xq" data-x-open style={`--i:${j}`}>
                <span class="xq-top" aria-hidden="true"><span class="xq-arm"></span><span class="xq-base"></span></span>
                <div class="xq-body"><p>{it}</p></div>
              </li>))}
          </ul>
        </div>
      </section>);
    // ---- Bloques «escena» del resto de páginas (26-11-2026). Cada uno lleva la animación propia de su servicio. ----
    const copy = (cls = 'xf-head') => <div class={cls}><Heading text={s.title} />{[...introFirst(k), ...s.paragraphs].map((p: string) => <p>{p}</p>)}<SeeAlso links={s.links} /></div>;
    // Producción audiovisual: la preparación, grabación y edición como una línea de tiempo de edición que se arma y se reproduce.
    if (b.type === 'timeline') return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap">
          {copy()}
          <div class="xt" data-x-open aria-hidden="true">
            <div class="xt-ruler">{Array.from({ length: 13 }, () => <i></i>)}</div>
            {TRACKS.map(([n, clips]: any, r: number) => (
              <div class="xt-track"><span class="xt-name">{n}</span><span class="xt-lane">{clips.map(([x, w, c]: any, j: number) => <span class:list={['xt-clip', c]} style={`left:${x}%;width:${w}%;--d:${r * .25 + j * .12}s`}></span>)}</span></div>))}
            <span class="xt-head"></span>
          </div>
          {s.items.length > 0 && <ul class="xt-items">{s.items.map((it: string) => { const x = listItem(it); return <li><h3>{x.t || it}</h3>{x.t && <p>{cap(x.d)}</p>}</li>; })}</ul>}
        </div>
      </section>);
    // Bodas: tres momentos de la celebración como copias que se revelan una tras otra.
    if (b.type === 'album') return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap">
          {copy()}
          <ul class="xa-list">
            {b.prints.map((m: any, j: number) => (
              <li class="xa" data-x-open style={`--i:${j}; --tilt:${[-2.4, 1.6, -1.2][j % 3]}deg`}>
                <figure><span class="xa-photo"><img src={media(m.image, m.sizes.at(-1))} srcset={srcset(m.image, m.sizes)} sizes="(max-width: 880px) 90vw, 360px" alt={m.alt} loading="lazy" decoding="async" /></span>
                <figcaption>{m.label}</figcaption></figure>
              </li>))}
          </ul>
        </div>
      </section>);
    // Spots: del boceto a la toma. Cada viñeta pasa de dibujo a imagen final con un barrido.
    if (b.type === 'storyboard') return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap">
          {copy()}
          <ol class="xs-list">
            {b.frames.map((f: any, j: number) => (
              <li class="xs" data-x-open style={`--i:${j}`}>
                <span class="xs-frame">
                  <img class="xs-sketch" src={media(f.image, 640)} alt="" loading="lazy" decoding="async" aria-hidden="true" />
                  <img class="xs-shot" src={media(f.image, f.sizes.at(-1))} srcset={srcset(f.image, f.sizes)} sizes="(max-width: 880px) 90vw, 380px" alt={f.alt} loading="lazy" decoding="async" />
                  <span class="xs-tag" aria-hidden="true"><b>Boceto</b><b>Toma</b></span>
                </span>
              </li>))}
          </ol>
        </div>
      </section>);
    // Drones: la foto empieza a ras de suelo y se aleja hasta la vista de conjunto al desplazarse.
    if (b.type === 'altura') return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap xv-split">
          {copy('v4-copy')}
          <figure class="xd" data-x-open>
            <span class="xd-in"><img src={media(b.image, b.sizes.at(-1))} srcset={srcset(b.image, b.sizes)} sizes="(max-width: 880px) 100vw, 540px" width={b.width} height={b.height} alt={b.alt} loading="lazy" decoding="async" /></span>
            <span class="xd-ui" aria-hidden="true"><span class="xv-c tl"></span><span class="xv-c tr"></span><span class="xv-c bl"></span><span class="xv-c br"></span><span class="xd-cross"></span><span class="xd-alt"><i></i></span></span>
          </figure>
        </div>
      </section>);
    // Inmobiliario: el plano se dibuja y un recorrido lo atraviesa, ambiente por ambiente.
    if (b.type === 'plano') return (
      <section id={id} class:list={['v4-sec', b.bg]} data-live-group>
        <div class="wrap xv-split">
          {copy('v4-copy')}
          <figure class="xp" data-x-open aria-hidden="true">
            <svg viewBox="0 0 520 380" fill="none">
              <g class="xp-rooms">
                <rect class="xp-room" style="--i:0" x="20" y="20" width="280" height="200" /><rect class="xp-room" style="--i:1" x="300" y="20" width="200" height="130" />
                <rect class="xp-room" style="--i:2" x="300" y="150" width="200" height="210" /><rect class="xp-room" style="--i:3" x="20" y="220" width="150" height="140" />
                <rect class="xp-room" style="--i:4" x="170" y="220" width="130" height="140" />
              </g>
              <path class="xp-walls" pathLength="1" d="M20 20H500V360H20Z M300 20V112 M300 150V360 M300 150H500 M20 220H120 M150 220H300 M170 220V360" />
              <path class="xp-win" pathLength="1" d="M70 20H230 M500 50V120 M500 200V320 M60 360H130" />
