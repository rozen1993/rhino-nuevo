      <section id={id} class:list={['v4-sec v4-check', b.bg]}>
        <div class="wrap v4-check-grid">
          <div class="v4-check-head"><Heading text={s.title} />{[...introFirst(k), ...s.paragraphs].map((p: string) => <p>{p}</p>)}<SeeAlso links={s.links} /></div>
          <ul class:list={['v4-list', `n${s.items.length}`]} data-list>
            {s.items.map((it: string, j: number) => { const x = listItem(it); return (
              <li style={`--i:${j}`}><svg class="v4-tick" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="url(#v4-brand)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.check} /></svg>
                <p>{x.t && <strong>{x.t}:</strong>} {x.d}</p></li>); })}
          </ul>
        </div>
      </section>);
    if (b.type === 'aside') {
      const a = asideParts(s);
      return (
      <section id={id} class:list={['v4-sec v4-aside', b.bg]} data-live-group>
        <div class="wrap v4-aside-grid">
          <div><Heading text={s.title} /><p class="v4-aside-lead">{a.body}</p><SeeAlso links={s.links} /></div>
          <aside class="v4-note"><LiveIcon name="info" size={28} /><p class="v4-note-label">A tener en cuenta</p><p>{a.note}</p></aside>
        </div>
      </section>);
    }
    if (b.type === 'text') return (
      <section id={id} class:list={['v4-sec v4-text', b.bg]}>
        <div class="wrap"><div class="section-heading"><Heading text={s.title} /><div>{[...introFirst(k), ...s.paragraphs].map((p: string) => <p>{p}</p>)}<SeeAlso links={s.links} /></div></div></div>
      </section>);
    if (b.type === 'band') return (
      <section id={id} class="v4-band">
        <div class:list={['v4-band-img', b.confeti && 'xb-confeti']} data-x-open={b.confeti ? '' : undefined}>
          {b.confeti && <canvas class="xb-canvas" aria-hidden="true"></canvas>}
          <img src={media(b.image, (b.sizes ?? [640, 1280]).at(-1))} srcset={srcset(b.image, b.sizes)} sizes="100vw" alt={b.alt} loading="lazy" decoding="async" />
          <div class="wrap"><Heading text={s.title} class="v4-band-title" /></div>
        </div>
        <div class="wrap"><div class="v4-band-card">{s.paragraphs.map((p: string) => <p>{p}</p>)}<SeeAlso links={s.links} /></div></div>
      </section>);
    if (b.type === 'keys') return (
      <section id={id} class:list={['v4-sec v4-keys', b.bg]} data-live-group>
        <div class="wrap">
          <ol class:list={['v4-keys-list', `n${b.group.length}`]} data-keys>
            <span class="v4-keys-track" aria-hidden="true"><i class="v4-keys-fill"></i></span>
            {b.group.map((g: any, j: number) => (
              <li><span class="v4-step-node"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC[b.icons?.[j] ?? 'check']} /></svg></span>
                <Heading text={g.title} />{g.paragraphs.map((p: string) => <p>{p}</p>)}<SeeAlso links={g.links} /></li>))}
          </ol>
        </div>
      </section>);
    return null;
  })}

  {related.length > 0 && (
    <section class:list={['v4-related color-field', lastBg === 'bg-l' && 'after-l']} aria-labelledby="v4-related-title">
      <Atmosphere seed={71} waves={false} />
      <ParticleField id="rhino-related-particles" label="servicios relacionados" />
      <svg class="v4-top-wave" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true"><path fill="white" opacity=".2" d="M0 0H1440V105Q720 -35 0 105Z"/><path fill="white" opacity=".3" d="M0 0H1440V88Q720 -52 0 88Z"/><path class="v4-wave-solid" fill="white" d="M0 0H1440V70Q720 -70 0 70Z"/></svg>
      <div class="wrap v4-related-in">
        <h2 id="v4-related-title">Servicios relacionados</h2>
        <p>Otros servicios que suelen acompañar este encargo. Se consultan y contratan por separado.</p>
        <div class="v4-nodes">
          {related.map((r: any) => (
            <PageLink pageId={r.id} label={shortName(r)} class="directory-node v4-node">
              <span class="node-circle"><svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC[iconFor(r.id)]} /></svg></span>
              <span class="node-label">{shortName(r)}</span>
            </PageLink>))}
        </div>
      </div>
      <svg class="v4-bottom-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path fill="#fff" opacity=".22" d="M0 0C480 20 660 118 1440 2V90H0Z"/><path fill="#fff" opacity=".38" d="M0 30C550 80 880 108 1440 22V90H0Z"/><path fill="#fff" d="M0 48C550 110 1040 98 1440 46V90H0Z"/></svg>
    </section>)}

  {closing && (
    <section class="v4-close" aria-labelledby="v4-close-title">
      <div class="wrap v4-close-grid">
        <div class="v4-close-copy">
          <h2 id="v4-close-title" class="v4-h2" data-rotulo><span class="v4-h2-text">{closing.title}</span><span class="presentation-accent" aria-hidden="true"></span></h2>
          {closing.paragraphs.map((p: string) => <p>{p}</p>)}
          <div class="v4-acts">
            <a class="action gradient-action" data-magnet href={wa} target="_blank" rel="noopener noreferrer"><span>{cta}</span><span class="action-arrow"><Icon /></span></a>
            <a class="inline-action" href={mail}>Escribir por correo <Icon size={18} /></a>
          </div>
          <SeeAlso links={closing.links ?? []} />
        </div>
        <ol class="v4-steps" data-steps>
          <span class="v4-track" aria-hidden="true"><i class="v4-fill"></i></span>
          {STEPS.map(([icon, title, text]) => (
            <li><span class="v4-step-node"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC[icon]} /></svg></span>
              <div><h3>{title}</h3><p>{text}</p></div></li>))}
        </ol>
      </div>
    </section>)}
</main>
<script src="../../scripts/v4-motion.ts"></script>
<script src="../../scripts/escena-motion.ts"></script>
<script src="../../scripts/fotogramas-camara.ts"></script>
