---
import home from '../data/home.json';import Header from './Header.astro';import Icon from './Icon.astro';import Atmosphere from './Atmosphere.astro';
import HeroParticles from './HeroParticles.astro';
import PanoramaWaves from './PanoramaWaves.astro';
---
<section id="inicio" class="hero hero-panorama color-field" aria-labelledby="home-title">
  <Atmosphere seed={29}/><HeroParticles/><PanoramaWaves/><Header/>
  <div class="panorama-content">
    <h1 id="home-title">{home.h1}</h1>
    <p class="panorama-lead">{home.intro.slice(0, home.intro.indexOf(". ") + 1)}</p>
    <p class="panorama-context">{home.intro.slice(home.intro.indexOf(". ") + 2)}</p>
    <a class="panorama-action" href="#consulta"><span>{home.cta}</span><Icon size={22}/></a>
  </div>
  <a class="panorama-whatsapp" href="https://wa.me/51965683542" target="_blank" rel="noopener noreferrer" aria-label="Consultar a Rhino por WhatsApp">
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 3a12.5 12.5 0 0 0-10.7 19L3.5 29l7-1.8A12.5 12.5 0 1 0 16 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m11 9 2 4-1.4 1.3c1 2.3 2.5 3.8 4.8 4.8l1.3-1.4 4 2c-.2 2.4-2.2 3.3-4.2 2.5-4.8-1.9-8.7-5.8-9.6-9.7C7.5 10.8 8.9 9.1 11 9Z" fill="currentColor"/></svg>
  </a>
</section>
