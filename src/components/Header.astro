---
import Icon from './Icon.astro';
import PageLink from './PageLink.astro';
import OrbitalMenu from './OrbitalMenu.astro';
const homeAnchor = (anchor: string) => `${Astro.url.pathname === '/' ? '' : '/'}#${anchor}`;
---
<header class="site-header wrap">
  <a class="brand" href={homeAnchor('inicio')} aria-label="Rhino Audiovisuales, inicio"><img src="/media/logo-rhino.png" width="261" height="197" alt=""/><span>RHINO</span></a>
  <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-menu" aria-haspopup="dialog">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <defs><linearGradient id="menu-ink" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="var(--brand-orange)"/><stop offset=".5" stop-color="var(--brand-pink)"/><stop offset="1" stop-color="var(--brand-violet)"/></linearGradient></defs>
      <path d="M4 6h16M4 12h16M4 18h16" stroke="url(#menu-ink)" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  </button>
  <nav class="nojs-nav" aria-label="Navegación principal">
    <PageLink pageId="P02" label="Servicios" fallbackHref={homeAnchor('servicios')}/><PageLink pageId="P27" label="Portafolio" fallbackHref={homeAnchor('proyectos')}/><PageLink pageId="P33" label="Contacto" fallbackHref={homeAnchor('consulta')}/>
  </nav>
</header>
<OrbitalMenu />
<script src="../scripts/navigation.ts"></script>
