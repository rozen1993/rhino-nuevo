---
// Layout de todas las páginas que no son la home: misma Base (head/SEO), cabecera ondulada con particles.js, pie y diálogos.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import Atmosphere from '../components/Atmosphere.astro';
import ParticleField from '../components/ParticleField.astro';
interface Props {
  pageId: string;
  service?: { confirmedVisible: true; name: string; description?: string };
  pending?: boolean;
  /** Cabecera a pantalla completa (show y páginas v4 con «hero»): la navegación va encima de la escena */
  fullHero?: boolean;
}
const { pageId, service, pending, fullHero } = Astro.props;
---
<Base pageId={pageId} service={service} pending={pending}>
  {(pageId === 'P19' || fullHero) && !pending ? <div class="theater-navigation"><Header /></div> : <div class="interior-masthead color-field">
    <Atmosphere seed={53} />
    <ParticleField id="rhino-interior-particles" label="la cabecera" />
    <Header />
  </div>}
  <slot />
  <Footer />
  <Dialogs />
</Base>
<style>
  .theater-navigation { position: absolute; inset: 0 0 auto; z-index: 20; color: white; }
</style>
